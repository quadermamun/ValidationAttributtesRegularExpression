@model ValidationAttributtes.Models.Student;

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="container">
    <div class="row">
        <div class="col-sm-4">
            <form class="d-grid" asp-controller="Home" asp-action="Index" method="post">
                <label asp-for="Name">Enter Name:</label>
                <input asp-for="Name" class="form-control" placeholder="Enter Name"/>
                <span asp-validation-for="Name" style="color:red"></span>
                <br />
                <label asp-for="Email">Enter Email:</label>
                <input asp-for="Email" class="form-control" placeholder="Enter Email" />
                <span asp-validation-for="Email" style="color:red"></span>
                <br />
                <label asp-for="Age">Enter Age:</label>
                <input asp-for="Age" class="form-control" placeholder="Enter Age" />
                <span asp-validation-for="Age" style="color:red"></span>
                <br />
                <label asp-for="Password">Enter Password:</label>
                <input asp-for="Password" class="form-control" placeholder="Enter Password" />
                <span asp-validation-for="Password" style="color:red"></span>
                <br />
                <label asp-for="PNumber">Enter Phone Number:</label>
                <input asp-for="PNumber" class="form-control" placeholder="Enter Phone Number" />
                <span asp-validation-for="PNumber" style="color:red"></span>
                <br />
                <input type="submit" value="Submit" class="btn btn-outline-primary btn-block" />
            </form>
        </div>
    </div>
</div>